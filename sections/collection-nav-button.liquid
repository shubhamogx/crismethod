<div class="coll-nav-sec">
  <div class="t4s-container">
    <div class="coll-nav-but">
      {% for block in section.blocks %}
        {% if block.settings.button_text != blank and block.settings.button_link != blank %}
          <a
            href="{{ block.settings.button_link }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection Navigation",
  "settings": [
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button Font Size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Navigation Button",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Collection Name"
        },
        {
          "type": "collection",
          "id": "button_link",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Navigation"
    }
  ]
}
{% endschema %}

<style>
  #shopify-section-{{ section.id }} .coll-nav-sec {
    background: {{ section.settings.section_bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .coll-nav-but {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .coll-nav-but a {
    color: {{ section.settings.button_text_color }};
    background: {{ section.settings.button_bg_color }};
    font-size: {{ section.settings.button_font_size }}px;
    text-decoration: none;
    padding: 10px 20px;
    transition: all 0.3s ease;
    border-radius: 9px;
  }

  #shopify-section-{{ section.id }} .coll-nav-but a:hover {
    color: {{ section.settings.button_hover_text_color }};
    background: {{ section.settings.button_hover_bg_color }};
  }
.coll-nav-but a:hover {
    opacity: .8;
}
</style>