{% style %}
  #cris-analyzer-section-{{ section.id }} {
    position: relative;
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    background: {{ section.settings.background_color }};
    min-height: 480px;
  }

  #cris-analyzer-section-{{ section.id }}.cris-analyzer--locked {
    overflow: hidden;
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__preview {
    min-height: 480px;
    filter: blur(6px);
    pointer-events: none;
    user-select: none;
    transform: scale(1.02);
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__placeholder {
    width: 100%;
    min-height: 480px;
    display: grid;
    place-items: center;
    color: {{ section.settings.text_color }};
    background: linear-gradient(135deg, #f2eee9 0%, #e9e4dd 100%);
    font-size: 24px;
    letter-spacing: 0.3px;
    text-align: center;
    padding: 24px;
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__overlay {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.34);
    padding: 20px;
    z-index: 2;
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__overlay--member {
    z-index: 3;
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__modal {
    max-width: 720px;
    width: 100%;
    text-align: center;
    background: {{ section.settings.modal_background }};
    border: 1px solid #e9e3da;
    border-radius: 12px;
    box-shadow: 0 16px 38px rgba(0, 0, 0, 0.12);
    padding: 28px 24px;
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__message {
    margin: 0 0 15px;
    color: {{ section.settings.text_color }};
    font-size: 16px;
    line-height: 1.7;
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__actions {
    display: flex;
    justify-content: space-evenly;
    align-items: stretch;
    gap: 20px;
    flex-wrap: wrap;
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__actions--single {
    justify-content: center;
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__action-block {
    flex: 1 1 260px;
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__actions--single .cris-analyzer-lock__action-block {
    flex: 0 1 auto;
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__action-label {
    margin: 0 0 15px;
    color: {{ section.settings.text_color }};
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 160px;
    padding: 10px 24px;
    border-radius: 8px;
    text-decoration: none;
    background: {{ section.settings.primary_button_bg }};
    color: {{ section.settings.primary_button_text }};
    border: 1px solid {{ section.settings.primary_button_bg }};
    transition: opacity 0.2s ease, background 0.2s ease, color 0.2s ease;
    cursor: pointer;
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__cta:hover {
    opacity: 0.85;
    color: {{ section.settings.primary_button_text }};
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__cta--secondary {
    background: {{ section.settings.secondary_button_bg }};
    color: {{ section.settings.secondary_button_text }};
    border: 1px solid {{ section.settings.secondary_button_border }};
  }

  #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__cta--secondary:hover {
    color: {{ section.settings.secondary_button_text }};
  }

  p.cris-analyzer-lock__message {
    margin-bottom: 15px !important;
  }
  .cris-analyzer-lock__modal {
    position: relative;
    padding-top: 38px !important;
}
.cris-analyzer-lock__modal button.cris-analyzer-lock__close {
  position: absolute;
  right: 0;
  top: 0;
}

  @media (max-width: 767px) {
    #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__actions {
      display: block;
    }

    #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__action-block + .cris-analyzer-lock__action-block {
      margin-top: 20px;
    }

    #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__message,
    #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__action-label {
      font-size: 14px;
      line-height: 1.5;
    }
	 #cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__modal--member {
  position: relative;
  padding-top: 52px;
}

#cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__close {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 36px;
  height: 36px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 999px;
  background: transparent;
  color: {{ section.settings.text_color }};
  cursor: pointer;
  line-height: 1;
  padding: 0;
  transition: background 0.2s ease, opacity 0.2s ease, border-color 0.2s ease;
}

#cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__close span {
  font-size: 24px;
  font-weight: 400;
  line-height: 1;
  transform: translateY(-1px);
}

#cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__close:hover {
  background: rgba(0, 0, 0, 0.05);
  opacity: 1;
}

#cris-analyzer-section-{{ section.id }} .cris-analyzer-lock__close:focus-visible {
  outline: 2px solid {{ section.settings.primary_button_bg }};
  outline-offset: 2px;
}
  }
{% endstyle %}