{% comment %}
  CRIS Skincare AI Analyzer — Shopify Section
{% endcomment %}

{% liquid
  assign member_tag_keyword = section.settings.member_tag_keyword | downcase | strip
  assign is_member = false

  if customer
    if member_tag_keyword == blank
      assign is_member = true
    else
      for ctag in customer.tags
        assign normalized_tag = ctag | downcase | strip
        if normalized_tag contains member_tag_keyword
          assign is_member = true
          break
        endif
      endfor
    endif
  elsif request.design_mode
    assign is_member = true
  endif

  assign show_non_member_lock = false
  assign show_member_beta_popup = false

  if is_member
    if section.settings.enable_member_beta_popup
      assign show_member_beta_popup = true
    endif
  else
    assign show_non_member_lock = true
  endif
%}

<div id="cris-analyzer-section-{{ section.id }}" class="{% if show_non_member_lock %}cris-analyzer--locked{% endif %}">
  {% if is_member %}
    <div id="cris-analyzer-root"></div>

    <script>
      window.process = window.process || { env: { NODE_ENV: "production" } };
      window.__CRIS_API_URL__ = {{ section.settings.api_url | json }};
      window.__CRIS_CUSTOMER_ID__ = {% if customer %}{{ customer.id }}{% else %}null{% endif %};
      window.dataLayer = window.dataLayer || [];
    </script>

    {{ 'cris-widget.iife.js' | asset_url | script_tag }}

    {% if show_member_beta_popup %}
      {% render 'cris-analyzer-member-popup', section: section %}
    {% endif %}

  {% else %}
    <div class="cris-analyzer-lock__preview" aria-hidden="true">
      {% if section.settings.locked_preview_image != blank %}
        {{
          section.settings.locked_preview_image
          | image_url: width: 2000
          | image_tag:
            loading: 'lazy',
            class: 'cris-analyzer-lock__image',
            alt: section.settings.preview_image_alt | default: 'CRIS Analyzer preview'
        }}
      {% else %}
        <div class="cris-analyzer-lock__placeholder">
          {{ section.settings.preview_placeholder_text }}
        </div>
      {% endif %}
    </div>

    <div class="cris-analyzer-lock__overlay" role="dialog" aria-modal="true" aria-label="{{ section.settings.modal_accessibility_label | escape }}">
      <div class="cris-analyzer-lock__modal">
        <p class="cris-analyzer-lock__message">
          {{ section.settings.non_member_message }}
        </p>

        <div class="cris-analyzer-lock__actions">
          <div class="cris-analyzer-lock__action-block">
            <p class="cris-analyzer-lock__action-label">
              {{ section.settings.join_block_label }}
            </p>

            <a
              href="{% if section.settings.non_member_button_link != blank %}{{ section.settings.non_member_button_link }}{% else %}{{ section.settings.fallback_join_url }}{% endif %}"
              class="cris-analyzer-lock__cta"
            >
              {{ section.settings.non_member_button_label }}
            </a>
          </div>

          <div class="cris-analyzer-lock__action-block">
            <p class="cris-analyzer-lock__action-label">
              {{ section.settings.login_block_label }}
            </p>

            <a
              href="{{ routes.account_login_url }}"
              class="cris-analyzer-lock__cta cris-analyzer-lock__cta--secondary"
            >
              {{ section.settings.login_button_label }}
            </a>
          </div>
        </div>
      </div>
    </div>
  {% endif %}
</div>

<script>
  document.addEventListener('click', function(event) {
    var closeButton = event.target.closest('[data-cris-close-member-popup]');
    if (!closeButton) return;

    var section = closeButton.closest('#cris-analyzer-section-{{ section.id }}');
    if (!section) return;

    var popup = section.querySelector('.cris-analyzer-lock__overlay--member');
    if (popup) {
      popup.style.display = 'none';
    }
  });
</script>

{% schema %}
