{%- liquid
  assign sid = section.id
  assign se_stts = section.settings
  assign form_id = 'password-main'
  assign checkbox_mail = settings.checkbox_mail
  assign platform_email = '94' | default: settings.platform_email
  assign html = 'div'
-%}

<div class="password-page-wrapper">
  
  <div class="password-bg-image"></div>
  <div class="password-overlay" style="background-color: rgba(0,0,0, {{ se_stts.overlay_opacity }});"></div>

  <div class="password-header">
    <div class="t4s-container">
      <div class="t4s-row t4s-align-items-center">
        <div class="t4s-col-item t4s-col-4 t4s-text-start">
           {%- if se_stts.logo != blank -%}
              <img src="{{ se_stts.logo | image_url: width: 500 }}" 
                   alt="{{ shop.name }}" 
                   style="max-width: {{ se_stts.logo_width }}px; filter: brightness(0) invert(1);">
           {%- else -%}
              <h1 class="h2" style="color: {{ se_stts.text_color }};">{{ shop.name }}</h1>
           {%- endif -%}
        </div>
        <div class="t4s-col-item t4s-col-8 t4s-text-end">
           {% comment %} <button data-sidebar-drawer class="t4s-btn-sidebar">
             <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="14" style="fill: currentColor; margin-right: 5px;"><path d="M144 144v48H304V144c0-44.2-35.8-80-80-80s-80 35.8-80 80zM80 192V144C80 64.5 144.5 0 224 0s144 64.5 144 144v48h16c35.3 0 64 28.7 64 64V448c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V256c0-35.3 28.7-64 64-64H80z"/></svg>
             {{ 'password_page.password_link' | t }}
           </button> {% endcomment %}
           {% form 'storefront_password' %}

  <input 
    type="password"
    name="password"
    placeholder="Enter using password"
    style="
      padding:10px;
      border:1px solid #fff;
      background:transparent;
      color:#fff;
      margin-right:10px;
    "
    required
  >

{% endform %}
        </div>
      </div>
    </div>
  </div>

  <div class="password-main">
    <div class="password-main__inner t4s-pr t4s-z-100">
      <div class="t4s-container t4s-text-center">
        <div class="password-content" style="color: {{ se_stts.text_color }};">
          <h2 class="password-content__title" style="color: {{ se_stts.text_color }};">{{ se_stts.heading }}</h2>
          <p>{{ se_stts.content }}</p>
          
          {% if se_stts.date != blank %}
            {{ 'countdown.css' | asset_url | stylesheet_tag }}
            <div class="t4s-countdown t4s-countdown-des-1 t4s-countdown-size-large t4s-text-center" style="--number-cl:{{ se_stts.text_color }};--text-cl:{{ se_stts.text_color }};--border-cl:{{ se_stts.text_color }};--bg-cl:transparent; --bd-width:1px; --bdr:0%; --space-item:20px;--space-item-mb: 10px;">
              <div class="time" data-countdown-t4s data-date='{{ se_stts.date }}'>
                <span class="countdown-days"><span class="cd_timet4 cd-number">%-D</span><span class="cd_txtt4 cd-text">Days</span></span>
                <span class="countdown-hours"><span class="cd_timet4 cd-number">%H</span><span class="cd_txtt4 cd-text">Hrs</span></span>
                <span class="countdown-min"><span class="cd_timet4 cd-number">%M</span><span class="cd_txtt4 cd-text">Min</span></span>
                <span class="countdown-sec"><span class="cd_timet4 cd-number">%S</span><span class="cd_txtt4 cd-text">Sec</span></span>
              </div>
            </div>
          {% endif %}

          <div class="password-form-container">
            {%- form 'customer', class: 't4s-pr t4s-z-100 t4s-newsletter__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              
              {%- if form.posted_successfully? -%}
                <div class="t4s-form-success" style="color: {{ se_stts.text_color }};">
                   <p>Thank you! We'll notify you as soon as we open.</p>
                </div>
              {%- else -%}
                <div class="t4s-newsletter__fields">
                  {%- if form.errors -%}
                    <div class="t4s-form-errors">
                      {{ form.errors | default_errors }}
                    </div>
                  {%- endif -%}
                  <div class="t4s-newsletter__inner t4s-row t4s-g-0 t4s-pr t4s-oh">
                    <div class="t4s-col-item is--col-email">
                      <input type="email" name="contact[email]" placeholder="{{ se_stts.newsletter_placeholder }}" class="t4s-newsletter__email" required>
                    </div>
                    <div class="t4s-col-item is--col-btn">
                      <button type="submit" class="t4s-w-100 t4s-newsletter__submit">
                        {{ se_stts.newsletter_button_text }}
                      </button>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endform -%}
          </div>

          {%- if se_stts.social != '0' -%}
            <div class="t4s-socials-block" style="--cl:{{ se_stts.text_color }};">
              {%- render 'social_sharing', style: 1, use_color_set: true, size: 'small', follow_social: true -%} 
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .t4s-website-wrapper {
    row-gap: 0px !important;
  }
  .password-page-wrapper {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
  }
  .password-header {
    position: absolute;
    top: 0; left: 0; width: 100%;
    padding: 30px 0;
    z-index: 100;
  }
  .t4s-btn-sidebar {
    background: transparent;
    border: 1px solid {{ se_stts.text_color }};
    color: {{ se_stts.text_color }};
    padding: 8px 15px;
    cursor: pointer;
    font-size: 13px;
    transition: 0.3s;
  }
  .t4s-btn-sidebar:hover {
    background: {{ se_stts.text_color }};
    color: #000;
  }
  .password-main {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 5;
  }
  .password-bg-image {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-image: url('https://cdn.shopify.com/s/files/1/0808/9619/6861/files/CRISSkinMarketplace-8150.jpg?v=1776177861');
    background-size: cover;
    background-position: center;
    z-index: 1;
  }
  .password-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 2;
  }
  .password-main__inner {
    width: 600px;
    margin: auto;
    max-width: 90%;
  }
  h2.password-content__title { font-size: 40px; margin-bottom: 20px; font-weight: bold; }
  
  .password-form-container {
    margin-top: 30px;
  }

  .t4s-form-success {
    font-size: 18px;
    padding: 20px;
    border: 1px solid currentColor;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(5px);
  }

  .t4s-form-errors {
    color: #ffbaba;
    margin-bottom: 15px;
    font-size: 14px;
  }

  input.t4s-newsletter__email {
    width: 100%;
    font-size: 14px;
    color: #583629;
    height: 48px;
    text-align: center;
    border: 1px solid #ddd;
    background: rgba(255,255,255,0.9);
  } 
  .t4s-newsletter__submit {
    background: var(--accent-color, #000);
    margin-top: 15px;
    height: 48px;
    color: #fff;
    border: none;
    cursor: pointer;
    width: 100%;
    font-weight: 600;
  }
  .t4s-socials { justify-content: center; display: flex; margin-top: 30px; }
  .password-header input[type="password"]::placeholder {
      color: #fff !important;
  }
  .password-header input[type="password"] {
    background-image: url(https://cdn.shopify.com/s/files/1/0808/9619/6861/files/lock.png?v=1780422605) !important;
    background-repeat: no-repeat !important;
    background-size: 15px !important;
    padding-left: 32px !important;
    background-position: 5% !important;
    max-width: 200px;
}
  
  @media (max-width: 767px) {
    h2.password-content__title { font-size: 28px; }
    .password-header { padding: 15px 0; }
    .password-header input[type="password"] {
        max-width: 180px;
    }
  }
</style>

{%- schema -%}
  {
    "name": "Unified Password Page",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo Image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Custom logo width",
        "min": 50,
        "max": 250,
        "step": 10,
        "default": 120,
        "unit": "px"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Coming Soon!"
      },
      {
        "type": "textarea",
        "id": "content",
        "label": "Content",
        "default": "We are about to go public so be sure to root on us and check back in anytime!"
      },
      {
        "type": "range",
        "id": "overlay_opacity",
        "label": "Background Overlay Opacity",
        "min": 0,
        "max": 0.9,
        "step": 0.1,
        "default": 0.4
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text/Icon Color",
        "default": "#ffffff"
      },
      {
        "type": "text",
        "id": "newsletter_placeholder",
        "label": "Newsletter placeholder",
        "default": "Your email address"
      },
      {
        "type": "text",
        "id": "newsletter_button_text",
        "label": "Button text",
        "default": "Notify me"
      },
      {
        "type": "select",
        "id": "social",
        "options": [
          { "value": "0", "label": "None" },
          { "value": "2", "label": "Follow" }
        ],
        "label": "Social:",
        "default": "2"
      }
    ]
  }
{% endschema %}