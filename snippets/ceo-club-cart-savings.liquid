{%- comment -%}
  CEO Club cart chooser: shop with or without membership (Few Moda–style).
  Script/config loads once from theme.liquid via ceo-club-cart-savings-boot.
{%- endcomment -%}

<div
  class="ceo-club-savings"
  data-ceo-club-savings
  hidden
  role="region"
  aria-label="Choose how you shop"
>
  <div data-ceo-chooser>
    <p class="ceo-club-savings__title">Choose How You Shop</p>
    <p class="ceo-club-savings__text ceo-club-savings__intro">
      Join the CEO Club and save <strong data-ceo-savings-amount>$0.00</strong> on this order
      with the additional 7% off every order perk — all in one checkout.
    </p>

    <div class="ceo-club-savings__options" role="radiogroup" aria-label="Membership options">
      <label class="ceo-club-savings__option" data-ceo-option="without">
        <input
          type="radio"
          name="ceo-club-mode"
          value="without"
          data-ceo-mode
        >
        <span class="ceo-club-savings__option-body">
          <span class="ceo-club-savings__option-top">
            <span class="ceo-club-savings__option-label">Without CEO Club</span>
            <span class="ceo-club-savings__option-price" data-ceo-price-without>$0.00</span>
          </span>
          <ul class="ceo-club-savings__list">
            <li>Pay full price</li>
            <li>No membership required</li>
          </ul>
        </span>
      </label>

      <label class="ceo-club-savings__option" data-ceo-option="with">
        <input
          type="radio"
          name="ceo-club-mode"
          value="with"
          data-ceo-mode
        >
        <span class="ceo-club-savings__option-body">
          <span class="ceo-club-savings__option-top">
            <span class="ceo-club-savings__option-label">With CEO Club</span>
            <span class="ceo-club-savings__option-price" data-ceo-price-with>$0.00</span>
          </span>
          <p class="ceo-club-savings__option-desc">
            Pay <span data-ceo-membership-price>$25.00</span>/mo and enjoy:
          </p>
          <ul class="ceo-club-savings__list">
            <li>An additional 7% off forever</li>
            <li>A FREE luxury product worth $100+ every 6 months of an active membership*</li>
            <li>FREE Shipping on all USA orders $200+</li>
            <li>Custom pre-built skincare routines &amp; educational guides</li>
            <li>Cancel anytime</li>
          </ul>
        </span>
      </label>
    </div>

    <p class="ceo-club-savings__note" data-ceo-busy-note hidden>Updating cart…</p>
  </div>
</div>
