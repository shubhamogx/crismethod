tom_text","settings":{"text":"Frequently Asked Questions","remove_br_tag":false,"tag":"p","fontf":"2","text_cl":"#583529","text_fs":20,"text_lh":0,"text_fw":300,"text_ls":0,"font_italic":false,"text_shadow":false,"text_mgb":15,"hidden_mobile":false,"text_fs_mb":16,"text_lh_mb":0,"text_ls_mb":0,"text_mgb_mobile":10}},"bl_col_4hW38N":{"type":"bl_col","settings":{"col_dk":"6","col_tb":"6","col_mb":"12","align_vertical":false,"content_align":"start","content_align_tablet":"start","content_align_mobile":"start","padding_inner":"","padding_inner_tb":"","padding_inner_mb":"","bg_cl":"rgba(0,0,0,0)"}},"html_FpzDBN":{"type":"html","settings":{"html_content":"<style>\n  .aj-accordion-wrapper {\n    max-width: 100%;\n    border-top: 1px solid #4a2e2b;\n  }\n\n  .aj-accordion-item {\n    border-bottom: 1px solid #4a2e2b;\n    overflow: hidden;\n  }\n\n  .aj-accordion-state {\n    display: none;\n  }\n\n  .aj-accordion-label {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 20px 0;\n    cursor: pointer;\n    font-size: 18px;\n    color: #583529;\n  }\n\n  .aj-plus-icon {\n    position: relative;\n    width: 18px;\n    height: 18px;\n    flex-shrink: 0;\n  }\n\n  .aj-plus-icon::before,\n  .aj-plus-icon::after {\n    content: '';\n    position: absolute;\n    background-color: #4a2e2b;\n    transition: transform 0.3s ease-in-out;\n  }\n\n  .aj-plus-icon::before {\n    top: 50%;\n    left: 0;\n    width: 100%;\n    height: 1px;\n    transform: translateY(-50%);\n  }\n\n  .aj-plus-icon::after {\n    top: 0;\n    left: 50%;\n    width: 1px;\n    height: 100%;\n    transform: translateX(-50%);\n  }\n\n  .aj-accordion-state:checked + .aj-accordion-label .aj-plus-icon::after {\n    transform: translateX(-50%) rotate(90deg);\n    opacity: 0;\n  }\n\n  .aj-accordion-content {\n    max-height: 0;\n    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .aj-accordion-state:checked ~ .aj-accordion-content {\n    max-height: 500px;\n    padding-bottom: 24px;\n  }\n\n  .aj-content-inner {\n    font-size: 16px;\n    line-height: 1.6;\n    color: #583529;\n  }\n<\/style>\n\n<div class=\"aj-accordion-wrapper\">\n  <div class=\"aj-accordion-item\">\n    <input type=\"checkbox\" id=\"aj-item-1\" class=\"aj-accordion-state\">\n    <label for=\"aj-item-1\" class=\"aj-accordion-label\">\n      <span>What if I’m new to the CRIS Method™?<\/span>\n      <div class=\"aj-plus-icon\"><\/div>\n    <\/label>\n    <div class=\"aj-accordion-content\">\n      <div class=\"aj-content-inner\">\n        The membership gives you structure from day one. You’ll learn how to organize your routine into Cleanse, Remove, Impact, and Saturate, so you never feel overwhelmed!\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <div class=\"aj-accordion-item\">\n    <input type=\"checkbox\" id=\"aj-item-2\" class=\"aj-accordion-state\">\n    <label for=\"aj-item-2\" class=\"aj-accordion-label\">\n      <span>Is this an auto-ship program?<\/span>\n      <div class=\"aj-plus-icon\"><\/div>\n    <\/label>\n    <div class=\"aj-accordion-content\">\n      <div class=\"aj-content-inner\">\n        No. This is not a forced product shipment.\n<br>\nYou receive points towards purchase and exclusive access benefits. You decide how and when to use your membership within the membership terms.\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <div class=\"aj-accordion-item\">\n    <input type=\"checkbox\" id=\"aj-item-3\" class=\"aj-accordion-state\">\n    <label for=\"aj-item-3\" class=\"aj-accordion-label\">\n      <span>Do members get access to special bundles?<\/span>\n      <div class=\"aj-plus-icon\"><\/div>\n    <\/label>\n    <div class=\"aj-accordion-content\">\n      <div class=\"aj-content-inner\">\n        Yes. CRIS Method™ members receive early access and priority inventory opportunities — including members-only bundles when available.\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <div class=\"aj-accordion-item\">\n    <input type=\"checkbox\" id=\"aj-item-4\" class=\"aj-accordion-state\">\n    <label for=\"aj-item-4\" class=\"aj-accordion-label\">\n      <span>What makes this different from shopping normally?<\/span>\n      <div class=\"aj-plus-icon\"><\/div>\n    <\/label>\n    <div class=\"aj-accordion-content\">\n      <div class=\"aj-content-inner\">\n        Members receive:\n<br><br>\n<ul>\n<li>Exclusive member-only pricing<\/li>\n<li>Priority inventory access<\/li>\n<li>Access to a custom CRIS Method tool to help you layer your existing and new products<\/li>\n<li>Seasonal CRIS routine guidance and consultations<\/li>\n<li>Members-only education<\/li>\n<\/ul>\nIt’s designed for consistency, savings, and smarter skincare decisions.\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <div class=\"aj-accordion-item\">\n    <input type=\"checkbox\" id=\"aj-item-5\" class=\"aj-accordion-state\">\n    <label for=\"aj-item-5\" class=\"aj-accordion-label\">\n      <span>Can I cancel anytime?<\/span>\n      <div class=\"aj-plus-icon\"><\/div>\n    <\/label>\n    <div class=\"aj-accordion-content\">\n      <div class=\"aj-content-inner\">\n        Yes. You can manage or cancel your membership according to the terms outlined at checkout. We believe in flexibility and transparency.\n      <\/div>\n    <\/div>\n  <\/div>\n<\/div>","hidden_mobile":false}}},"block_order":["bl_col_ca63HY","custom_text_8AEXXq","bl_col_4hW38N","html_FpzDBN"],"name":"Custom section","settings":{"space_h_item":"30","space_v_item":"30","space_h_item_mb":"10","space_v_item_mb":"10","layout":"t4s-container-wrap","cl_bg":"","cl_bg_gradient":"","mg":",,50px,","pd":"","mg_tb":",,50px,","pd_tb":"","mg_mb":",,30px,","pd_mb":"","use_cus_css":false,"code_cus_css":""}},"heading":{"type":"heading-template","disabled":true,"settings":{"heading_fullwidth":false,"use_specify_image":true,"parallax":false,"color":"#000000","overlay":54,"padding":50,"paddingmb":50,"mg_b":50,"mg_bmb":50,"content_align":"t4s-text-center","bg_pos":"center center","bg_repe